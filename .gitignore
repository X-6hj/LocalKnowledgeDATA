# Python generated files
__pycache__/
*.py[cod]
# Portable Windows Python needs native extension modules despite *.pyd matching above.
!runtime/windows-python/*.pyd

# Runtime state and logs
.server.pid
logs/*.log*

# Personal knowledge files are private by default. Only the exact reviewed files
# below are public; future files under the same folders remain ignored.
library/*
!library/示例资料/
library/示例资料/*
!library/示例资料/_分类.md
!library/示例资料/欢迎使用/
