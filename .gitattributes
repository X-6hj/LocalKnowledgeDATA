# Keep cross-platform checkouts stable; Windows launchers override to CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*._pth text eol=lf
LICENSE text eol=lf
runtime/windows-python/LICENSE.txt -whitespace
